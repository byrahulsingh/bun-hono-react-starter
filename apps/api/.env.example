NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace (default: info in production, debug otherwise)
LOG_LEVEL=

# Public address of the product, including any subpath the host mounts it under:
#   https://app.example.com   or   https://example.com/app
# The API is always <APP_URL>/api. Required in production; defaults to http://localhost:3000.
APP_URL=

DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Connections per process. Keep (app replicas + worker replicas) x DB_POOL_MAX below Postgres max_connections.
DB_POOL_MAX=10

# Root secret of this install, 32+ random characters: openssl rand -base64 48
# Keys for encrypting secrets and hashing tokens are derived from it. Back it up with the database:
# changing it makes encrypted values unreadable.
APP_SECRET=
# Where the caller's IP comes from: `socket` (browsers connect directly) or the header your reverse
# proxy sets, e.g. x-forwarded-for. Required in production.
CLIENT_IP_SOURCE=socket
# Optional fixed token for the first-owner setup page. Without it a one-time link is printed in the log.
SETUP_TOKEN=

# Outgoing email. Optional: an owner can enter the mail server in Settings → Email instead;
# these win when set. Leave empty in development: Mailpit (bun run db:up) catches everything at
# http://localhost:8025. Production: your SMTP server (Gmail app password, Amazon SES, SendGrid, M365).
SMTP_HOST=
# 465 with SMTP_SECURE=true, or 587 with SMTP_SECURE=false
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# An address the SMTP account may send as. A bare address gets the product name from
# Settings → Branding as its sender name; "Name <address>" fixes the name instead.
MAIL_FROM=

# Comma-separated. Leave empty: the client is same-origin. Only list a different site whose
# browser code must call this API.
CORS_ORIGINS=
# Absolute path to the built client (apps/client/dist). Leave unset in development.
WEB_DIST=
